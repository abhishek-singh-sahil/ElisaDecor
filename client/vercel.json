{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://elisadecor-backend.onrender.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://elisadecor-backend.onrender.com/robots.txt"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://elisadecor-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads|sitemap.xml|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}
